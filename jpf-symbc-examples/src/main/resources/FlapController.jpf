classpath=${jpf-symbc}/jpf-symbc-examples/target/classes
sourcepath=${jpf-symbc}/jpf-symbc-examples/src/main/java
target=FlapController

symbolic.method=FlapController.startThreads(sym#sym#sym)
#listener = gov.nasa.jpf.symbc.SymbolicListener
#symbolic.lazy=true
#vm.storage.class=nil
symbolic.min_int=-100
symbolic.max_int=100
symbolic.undefined=100000
#symbolic.debug=true
search.depth_limit=10
search.multiple_errors=true
listener = gov.nasa.jpf.symbc.sequences.SymbolicSequenceListener