target = uberlazy.TestDriver00

classpath = ${jpf-symbc}/jpf-symbc-examples/target/classes

sourcepath = ${jpf-symbc}/jpf-symbc-examples/src/main/java 

symbolic.lazy = true

#the configuration allows to consider all subtypes
#during the instantiation. All subtypes are considered
#by default in the aliasing. 
symbolic.lazy.subtypes = true

type_classpath = ${jpf-symbc}/jpf-symbc-examples/target/classes/uberlazy

symbolic.method = uberlazy.TestDriver00.run(), uberlazy.TestDriver00.swapNode()