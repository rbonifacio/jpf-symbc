target=ExampleDReal
classpath=${jpf-symbc}/jpf-symbc-examples/target/classes
sourcepath=${jpf-symbc}/jpf-symbc-examples/src/main/java
symbolic.method = ExampleDReal.test(sym#sym)

symbolic.dp=dreal

dreal.mode = strictified 
#or relaxed

dreal.precision=0.001
#dreal.timeBound=10000   (in milliseconds) 

-Ddreal-bin-path=<path to the bin folder of dReal>