target = sequences.BankAccountDriverSeqSym

classpath = ${jpf-symbc}/jpf-symbc-examples/target/classes

sourcepath = ${jpf-symbc}/jpf-symbc-examples/src/main/java

symbolic.method = sequences.BankAccount.deposit(sym),sequences.BankAccount.withdraw(sym),sequences.BankAccountDriverSeqSym.flag(sym)

coverage.include=*.BankAccount
coverage.show_methods=true
coverage.show_bodies=true

symbolic.minint=-100

symbolic.maxint=100
symbolic.undefined=-1000

#search.class = .search.heuristic.BFSHeuristic

listener = gov.nasa.jpf.symbc.sequences.SymbolicSequenceListener,gov.nasa.jpf.listener.CoverageAnalyzer
coverage.show_methods=true