target=coverage.MyDriverForPathAnnotations

classpath=${jpf-symbc}/jpf-symbc-examples/target/classes

sourcepath=${jpf-symbc}/jpf-symbc-examples/src/main/java

# analyze TestPaths.testMe(int x, boolean b) using symbolic values for 'x' and
# concrete value for 'b'
symbolic.method= coverage.MyClassWithPathAnnotations.myMethod(sym#sym)

listener = .symbc.SymbolicListener

vm.storage.class=nil



