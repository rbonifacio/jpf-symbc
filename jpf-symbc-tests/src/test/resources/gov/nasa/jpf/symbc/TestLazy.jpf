

classpath=${jpf-symbc}/jpf-symbc-tests/target/test-classes

sourcepath=${jpf-symbc}/jpf-symbc-tests/src/test/java


target=gov.nasa.jpf.symbc.TestLazy
symbolic.lazy = true
symbolic.lazy.subtypes = true
symbolic.method = gov.nasa.jpf.symbc.TestLazy.f(sym#sym)
symbolic.minint=-25
symbolic.maxint=25
symbolic.undefined=-100
listener = gov.nasa.jpf.symbc.SymbolicListener
#symbolic.debug=true